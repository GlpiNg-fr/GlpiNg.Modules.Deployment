@page "/self-service"
@using GlpiNg.Modules.Abstractions.Deployment
@using GlpiNg.Modules.Deployment.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject SelfServiceDeploymentService Service
@rendermode InteractiveServer

<PageTitle>@T("Libre-service — GlpiNg")</PageTitle>

<div class="glping-list-page">
    @if (_message is not null)
    {
        <div class="alert @(_messageIsError ? "alert-danger" : "alert-success")">@_message</div>
    }

    <div class="card mb-3">
        <div class="card-header"><h3 class="card-title"><i class="ti ti-package me-1"></i>@T("Paquets disponibles")</h3></div>
        @if (_packages is null)
        {
            <div class="card-body text-muted">@T("Chargement…")</div>
        }
        else if (_packages.Count == 0)
        {
            <div class="card-body text-muted">@T("Aucun paquet n'est proposé en libre-service.")</div>
        }
        else
        {
            <div class="list-group list-group-flush">
                @foreach (SelfServicePackageOption package in _packages)
                {
                    <div class="list-group-item">
                        <div class="row align-items-center">
                            <div class="col">
                                <div class="fw-bold">@package.Name</div>
                                @if (!string.IsNullOrWhiteSpace(package.Description))
                                {
                                    <div class="text-muted small">@package.Description</div>
                                }
                            </div>
                            <div class="col-auto">
                                @if (_computers[package.PackageId].Count == 0)
                                {
                                    <span class="text-muted small">@T("Aucun poste éligible")</span>
                                }
                                else
                                {
                                    foreach (SelfServiceComputerOption computer in _computers[package.PackageId])
                                    {
                                        <button type="button" class="btn btn-sm btn-primary ms-1" disabled="@_busy"
                                                @onclick="() => RequestAsync(package.PackageId, computer.ComputerId)">
                                            <i class="ti ti-download me-1"></i>@T("Installer sur {0}", computer.Name)
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="card">
        <div class="card-header"><h3 class="card-title"><i class="ti ti-history me-1"></i>@T("Mes demandes")</h3></div>
        @if (_history is null or { Count: 0 })
        {
            <div class="card-body text-muted">@T("Aucune demande.")</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table card-table table-vcenter">
                    <thead><tr><th>@T("Date")</th><th>@T("Paquet")</th><th>@T("Poste")</th><th>@T("Statut")</th></tr></thead>
                    <tbody>
                        @foreach (SelfServiceRequestHistoryEntry entry in _history)
                        {
                            <tr>
                                <td>@Display.DateTime(entry.CreatedAtUtc)</td>
                                <td>@entry.PackageName</td>
                                <td>@entry.ComputerName</td>
                                <td><span class="badge @entry.StatusBadgeCssClass">@entry.StatusLabel</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private List<SelfServicePackageOption>? _packages;
    private readonly Dictionary<int, List<SelfServiceComputerOption>> _computers = [];
    private List<SelfServiceRequestHistoryEntry>? _history;
    private int _userId;
    private bool _busy;
    private bool _messageIsError;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState? auth = AuthStateTask is null ? null : await AuthStateTask;
        string? claim = auth?.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (!int.TryParse(claim, out _userId))
        {
            _packages = [];
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _packages = await Service.GetAvailablePackagesAsync(_userId);
        _computers.Clear();
        foreach (SelfServicePackageOption package in _packages)
        {
            _computers[package.PackageId] = await Service.GetEligibleComputersAsync(_userId, package.PackageId);
        }

        _history = await Service.GetRequestHistoryAsync(_userId);
    }

    private async Task RequestAsync(int packageId, int computerId)
    {
        _busy = true;
        try
        {
            DeploymentAssignmentResult result = await Service.RequestDeploymentAsync(_userId, packageId, computerId);
            _messageIsError = result.Status != DeploymentAssignmentStatus.Success;
            _message = _messageIsError ? result.ErrorMessage ?? T("La demande a échoué.") : T("Demande envoyée.");
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
