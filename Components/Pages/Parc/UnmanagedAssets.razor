@page "/parc/unmanaged"
@using GlpiNg.Modules.Deployment.Models
@rendermode InteractiveServer

@* Vue « Parc » des actifs non gérés. La donnée est celle de DiscoveredNetworkDevice, alimentée par
   la découverte réseau (voir NetworkDeviceImportService) : c'est déjà l'équivalent de l'actif non
   géré de GLPI, donc pas de second modèle concurrent. La page /tools/deployments/discovered-devices
   reste la vue « exploitation » (suivi d'un scan) ; celle-ci est la vue « inventaire », avec
   recherche, tri, pagination et conversion vers le type d'actif voulu. *@

<PageTitle>GlpiNg — Actifs non gérés</PageTitle>

<div class="glpi-list-page">
<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between glpi-list-toolbar">
        <div class="btn-list">
            <div class="input-icon" style="width: 260px;">
                <span class="input-icon-addon"><i class="ti ti-search"></i></span>
                <input type="text" class="form-control" placeholder="Rechercher..." value="@_search"
                       @oninput="@((ChangeEventArgs e) => OnSearchInput((string?)e.Value))" />
            </div>
            <select class="form-select w-auto" value="@(_statusFilter?.ToString() ?? "")" @onchange="OnStatusFilterChanged">
                <option value="">Tous les états</option>
                <option value="@nameof(DiscoveredDeviceStatus.New)">Nouveau</option>
                <option value="@nameof(DiscoveredDeviceStatus.Imported)">Converti</option>
                <option value="@nameof(DiscoveredDeviceStatus.Ignored)">Ignoré</option>
            </select>
        </div>

        <div class="btn-list align-items-center">
            <button type="button" class="btn btn-icon" @onclick="LoadAsync" title="Rafraîchir">
                <i class="ti ti-refresh"></i>
            </button>
        </div>
    </div>

    @if (_message is not null)
    {
        <div class="alert @(_messageIsError ? "alert-danger" : "alert-success") m-3 mb-0" role="alert">@_message</div>
    }

    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th class="glpi-sortable-th" @onclick='() => SetSort("ip")'>Adresse IP @SortIndicator("ip")</th>
                    <th class="glpi-sortable-th" @onclick='() => SetSort("hostname")'>Nom d'hôte @SortIndicator("hostname")</th>
                    <th class="glpi-sortable-th" @onclick='() => SetSort("mac")'>Adresse MAC @SortIndicator("mac")</th>
                    <th class="glpi-sortable-th" @onclick='() => SetSort("type")'>Type deviné @SortIndicator("type")</th>
                    <th class="glpi-sortable-th" @onclick='() => SetSort("lastseen")'>Vu le @SortIndicator("lastseen")</th>
                    <th class="glpi-sortable-th" @onclick='() => SetSort("status")'>État @SortIndicator("status")</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (_filtered.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-secondary py-4">
                            Aucun actif non géré. Ils apparaissent ici après une tâche de découverte réseau.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (DiscoveredNetworkDevice device in _paged)
                    {
                        <tr>
                            <td class="fw-semibold"><i class="ti ti-help me-1 text-secondary"></i>@device.IpAddress</td>
                            <td>@(device.Hostname ?? device.SysName ?? "—")</td>
                            <td>@(device.MacAddress ?? "—")</td>
                            <td>@(device.GuessedType ?? "—")</td>
                            <td>@device.LastSeenAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="badge @StatusBadgeClass(device.Status) text-white">@StatusLabel(device.Status)</span></td>
                            <td class="text-end">
                                @if (device.Status == DiscoveredDeviceStatus.New)
                                {
                                    <div class="btn-list justify-content-end">
                                        <div class="dropdown">
                                            <button type="button" class="btn btn-sm btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="ti ti-arrow-move-right me-1"></i>Convertir en
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                @foreach ((PromotionTarget target, string label, string icon) in PromotionTargets)
                                                {
                                                    <li>
                                                        <button type="button" class="dropdown-item" @onclick="() => PromoteAsync(device, target)">
                                                            <i class="ti @icon me-2"></i>@label
                                                        </button>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                        <button type="button" class="btn btn-sm" @onclick="() => IgnoreAsync(device)">
                                            <i class="ti ti-eye-off me-1"></i>Ignorer
                                        </button>
                                    </div>
                                }
                                else if (device.Status == DiscoveredDeviceStatus.Imported && device.PromotedNetworkEquipment is { } promoted)
                                {
                                    <a href="@($"/parc/network-equipments/{promoted.Id}")" class="btn btn-sm">
                                        <i class="ti ti-external-link me-1"></i>Voir l'actif
                                    </a>
                                }
                                else
                                {
                                    <span class="text-secondary">—</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="card-footer d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2 text-secondary">
            <span>Éléments par page</span>
            <select class="form-select form-select-sm w-auto" value="@_pageSize"
                    @onchange="@((ChangeEventArgs e) => SetPageSize(int.Parse((string)e.Value!)))">
                @foreach (int size in PageSizeOptions)
                {
                    <option value="@size">@size</option>
                }
            </select>
        </div>

        @if (_filtered.Count > 0)
        {
            <div class="d-flex align-items-center gap-3">
                <span class="text-secondary">
                    @(((_currentPage - 1) * _pageSize) + 1)–@(Math.Min(_currentPage * _pageSize, _filtered.Count)) sur @_filtered.Count
                </span>
                <ul class="pagination pagination-sm m-0">
                    <li class="page-item @(_currentPage <= 1 ? "disabled" : "")">
                        <button type="button" class="page-link" @onclick="() => GoToPage(_currentPage - 1)" disabled="@(_currentPage <= 1)">
                            <i class="ti ti-chevron-left"></i>
                        </button>
                    </li>
                    <li class="page-item disabled"><span class="page-link">Page @_currentPage / @TotalPages</span></li>
                    <li class="page-item @(_currentPage >= TotalPages ? "disabled" : "")">
                        <button type="button" class="page-link" @onclick="() => GoToPage(_currentPage + 1)" disabled="@(_currentPage >= TotalPages)">
                            <i class="ti ti-chevron-right"></i>
                        </button>
                    </li>
                </ul>
            </div>
        }
    </div>
</div>
</div>
