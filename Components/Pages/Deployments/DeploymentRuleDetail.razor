@page "/tools/deployments/rules/{RuleId:int}"
@using GlpiNg.Modules.Inventory.Models
@using GlpiNg.Modules.Deployment.Models
@rendermode InteractiveServer

<PageTitle>@(_rule?.Name ?? T("Règle de déploiement")) — GlpiNg</PageTitle>

<DeploymentTopMenu Current="rules" />

@if (_rule is null)
{
    <div class="text-center text-secondary py-5">
        <i class="ti ti-git-branch fs-1"></i>
        <p class="mt-2">@T("Cette règle est introuvable.")</p>
    </div>
}
else
{
    <div class="glping-fiche-layout">
        <aside class="glping-fiche-sidebar">
            <button type="button" class="glping-fiche-tab-item @(_activeTabKey == "main" ? "active" : "")" @onclick='() => SetTab("main")'>
                <i class="ti ti-git-branch"></i>
                <span>@T("Règle")</span>
            </button>
            <button type="button" class="glping-fiche-tab-item @(_activeTabKey == "criteria" ? "active" : "")" @onclick='() => SetTab("criteria")'>
                <i class="ti ti-filter"></i>
                <span>@T("Critères")</span>
                <span class="glping-fiche-tab-count">@_rule.Criteria.Count</span>
            </button>
            <button type="button" class="glping-fiche-tab-item @(_activeTabKey == "actions" ? "active" : "")" @onclick='() => SetTab("actions")'>
                <i class="ti ti-package"></i>
                <span>@T("Paquets")</span>
                <span class="glping-fiche-tab-count">@_rule.Actions.Count</span>
            </button>
            <button type="button" class="glping-fiche-tab-item @(_activeTabKey == "matches" ? "active" : "")" @onclick='() => SetTab("matches")'>
                <i class="ti ti-list"></i>
                <span>@T("Correspondances")</span>
                <span class="glping-fiche-tab-count">@_matches.Count</span>
            </button>
        </aside>

        <div class="glping-fiche-panel">
            @switch (_activeTabKey)
            {
                case "main":
                    <div class="row">
                        <div class="col-md-6">
                            <div class="glping-fiche-field">
                                <label>@T("Nom")</label>
                                <input class="form-control" @bind="_rule.Name" @bind:event="oninput" />
                            </div>
                            <div class="glping-fiche-field">
                                <label>@T("Actif")</label>
                                @* Valeur et gestionnaire explicites plutot que @bind : sur un <select> lie a un booleen,
                                   Blazor ecrit dans l'attribut value le resultat de bool.ToString(), soit "True" ou
                                   "False". Aucune option en minuscules ne correspondait alors, la liste restait bloquee
                                   sur son premier choix et le modele n'etait jamais mis a jour. *@
                                <select class="form-select" value="@(_rule.IsActive ? "true" : "false")"
                                        @onchange="@((ChangeEventArgs e) => _rule.IsActive = (string?)e.Value == "true")">
                                    <option value="true">@T("Oui")</option>
                                    <option value="false">@T("Non")</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="glping-fiche-field">
                                <label>@T("Commentaires")</label>
                                <textarea class="form-control" rows="4" @bind="_rule.Comment"></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button type="button" class="btn btn-outline-danger" @onclick="DeleteAsync">
                            <i class="ti ti-trash me-1"></i>@T("Supprimer définitivement")
                        </button>
                        <button type="button" class="btn btn-primary" disabled="@_isSaving" @onclick="SaveAsync">
                            <i class="ti ti-device-floppy me-1"></i>@(_isSaving ? T("Enregistrement…") : T("Sauvegarder"))
                        </button>
                    </div>
                    break;

                case "criteria":
                    <div class="glping-fiche-block">
                        <div class="glping-fiche-block-title"><i class="ti ti-filter"></i>@T("Critères ({0})", _rule.Criteria.Count)</div>
                        <p class="text-secondary">
                            @T("Un ordinateur correspond à la règle si l'ensemble des critères ci-dessous, combinés dans l'ordre via ET/OU, est vérifié. Sans critère, la règle ne correspond à aucun ordinateur.")
                        </p>

                        @if (_rule.Criteria.Count > 0)
                        {
                            <div class="table-responsive mb-3">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>@T("Lien")</th>
                                            <th>@T("Champ")</th>
                                            <th>@T("Opérateur")</th>
                                            <th>@T("Valeur")</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (DeploymentRuleCriterion criterion in _rule.Criteria.OrderBy(c => c.SortOrder))
                                        {
                                            <tr>
                                                <td>@(criterion.SortOrder == 0 ? "—" : LinkLabel(criterion.Link))</td>
                                                <td>@FieldLabel(criterion.Field)</td>
                                                <td>@OperatorLabel(criterion.Operator)</td>
                                                <td>@(criterion.Operator == DeployCriterionOperator.IsEmpty ? "—" : criterion.Value)</td>
                                                <td class="text-end">
                                                    <button type="button" class="btn btn-sm btn-icon text-danger" @onclick="() => RemoveCriterionAsync(criterion)">
                                                        <i class="ti ti-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        <div class="row g-2 align-items-end">
                            <div class="col-md-2">
                                <label class="form-label">@T("Lien")</label>
                                <select class="form-select" @bind="_newCriterion.Link" disabled="@(_rule.Criteria.Count == 0)">
                                    <option value="@DeployCriterionLink.And">@T("ET")</option>
                                    <option value="@DeployCriterionLink.Or">@T("OU")</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">@T("Champ")</label>
                                <select class="form-select" @bind="_newCriterion.Field" @bind:after="OnCriterionFieldChanged">
                                    @foreach (DeployCriterionField field in Enum.GetValues<DeployCriterionField>())
                                    {
                                        <option value="@field">@FieldLabel(field)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">@T("Opérateur")</label>
                                <select class="form-select" @bind="_newCriterion.Operator" @bind:after="OnCriterionOperatorChanged">
                                    @foreach (DeployCriterionOperator op in Enum.GetValues<DeployCriterionOperator>())
                                    {
                                        <option value="@op">@OperatorLabel(op)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">@T("Valeur")</label>
                                @if (_newCriterion.Operator == DeployCriterionOperator.IsEmpty)
                                {
                                    <input class="form-control" disabled placeholder="—" />
                                }
                                else if (_newCriterion.Operator is DeployCriterionOperator.Is or DeployCriterionOperator.IsNot
                                    && _distinctValuesCache.TryGetValue(_newCriterion.Field, out List<string>? distinctValues))
                                {
                                    <select class="form-select" @bind="_newCriterion.Value">
                                        <option value="">-----</option>
                                        @foreach (string value in distinctValues)
                                        {
                                            <option value="@value">@value</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input class="form-control" @bind="_newCriterion.Value" />
                                }
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn btn-primary w-100" @onclick="AddCriterionAsync">
                                    <i class="ti ti-plus me-1"></i>@T("Ajouter")
                                </button>
                            </div>
                        </div>
                    </div>
                    break;

                case "actions":
                    <div class="glping-fiche-block">
                        <div class="glping-fiche-block-title"><i class="ti ti-package"></i>@T("Paquets assignés ({0})", _rule.Actions.Count)</div>
                        <p class="text-secondary">
                            <i class="ti ti-info-circle me-1"></i>@T("Quand la règle correspond, chaque paquet ci-dessous est assigné à l'ordinateur (assignation \"à la demande\", identique à un clic manuel depuis sa fiche).")
                        </p>

                        @if (_rule.Actions.Count > 0)
                        {
                            <div class="table-responsive mb-3">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>@T("Paquet")</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (DeploymentRuleAction action in _rule.Actions)
                                        {
                                            <tr>
                                                <td><i class="ti ti-package me-1 text-secondary"></i>@(action.Package?.Name ?? "?")</td>
                                                <td class="text-end">
                                                    <button type="button" class="btn btn-sm btn-icon text-danger" @onclick="() => RemoveActionAsync(action)">
                                                        <i class="ti ti-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        <div class="d-flex gap-2">
                            <select class="form-select" style="max-width: 320px;" @bind="_packageIdToAdd">
                                <option value="0">@T("-- Choisir un paquet --")</option>
                                @foreach (DeploymentPackage package in _availablePackages)
                                {
                                    <option value="@package.Id">@package.Name</option>
                                }
                            </select>
                            <button type="button" class="btn btn-primary" disabled="@(_packageIdToAdd == 0)" @onclick="AddActionAsync">
                                <i class="ti ti-plus me-1"></i>@T("Ajouter")
                            </button>
                        </div>
                    </div>
                    break;

                case "matches":
                    <div class="glping-fiche-block">
                        <div class="glping-fiche-block-title"><i class="ti ti-list"></i>@T("Ordinateurs correspondants ({0})", _matches.Count)</div>
                        <p class="text-secondary">
                            @T("Aperçu en lecture seule des ordinateurs correspondant actuellement aux critères — l'assignation automatique n'a lieu qu'à leur prochain inventaire. Utilisez « Évaluer maintenant » pour l'appliquer tout de suite au parc existant.")
                        </p>

                        <div class="d-flex align-items-center gap-2 mb-3">
                            <button type="button" class="btn btn-primary" disabled="@(_isEvaluating || _rule.Actions.Count == 0)" @onclick="EvaluateNowAsync">
                                <i class="ti ti-player-play me-1"></i>@(_isEvaluating ? T("Évaluation…") : T("Évaluer maintenant"))
                            </button>
                            @if (_rule.Actions.Count == 0)
                            {
                                <span class="text-secondary small">@T("Ajoutez au moins un paquet dans l'onglet « Paquets ».")</span>
                            }
                        </div>

                        @if (_evaluationResultMessage is not null)
                        {
                            <p class="text-success"><i class="ti ti-circle-check me-1"></i>@_evaluationResultMessage</p>
                        }

                        @if (_rule.Criteria.Count == 0)
                        {
                            <div class="glping-config-placeholder">
                                <i class="ti ti-filter"></i>
                                <p class="mb-0">@T("Ajoutez au moins un critère dans l'onglet « Critères » pour cibler des ordinateurs.")</p>
                            </div>
                        }
                        else if (_matches.Count == 0)
                        {
                            <div class="glping-config-placeholder">
                                <i class="ti ti-list-search"></i>
                                <p class="mb-0">@T("Aucun ordinateur ne correspond actuellement à ces critères.")</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive mb-0">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>@T("Nom")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (Computer computer in _matches)
                                        {
                                            <tr>
                                                <td><a href="@($"/parc/computer/{computer.Id}")">@computer.Name</a></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                    break;
            }
        </div>
    </div>
}

@code {
    private static string FieldLabel(DeployCriterionField field) => field switch
    {
        DeployCriterionField.Name => T("Nom"),
        DeployCriterionField.SerialNumber => T("Numéro de série"),
        DeployCriterionField.Manufacturer => T("Fabricant"),
        DeployCriterionField.Model => T("Modèle"),
        DeployCriterionField.OperatingSystem => T("Système d'exploitation"),
        DeployCriterionField.OsVersion => T("Version de l'OS"),
        DeployCriterionField.Status => T("Statut"),
        DeployCriterionField.Site => T("Site"),
        DeployCriterionField.Building => T("Bâtiment"),
        DeployCriterionField.Room => T("Salle"),
        DeployCriterionField.AssignedUser => T("Utilisateur"),
        _ => field.ToString()
    };

    private static string OperatorLabel(DeployCriterionOperator op) => op switch
    {
        DeployCriterionOperator.Contains => "contient",
        DeployCriterionOperator.NotContains => T("ne contient pas"),
        DeployCriterionOperator.Is => "est",
        DeployCriterionOperator.IsNot => T("n'est pas"),
        DeployCriterionOperator.IsEmpty => T("est vide"),
        _ => op.ToString()
    };

    private static string LinkLabel(DeployCriterionLink link) => link == DeployCriterionLink.Or ? T("OU") : T("ET");
}
