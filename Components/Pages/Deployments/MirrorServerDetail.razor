@page "/tools/deployments/mirrors/{MirrorServerId:int}"
@using GlpiNg.Modules.Deployment.Models
@rendermode InteractiveServer

<PageTitle>@(_mirrorServer?.Name ?? "Serveur miroir") — GlpiNg</PageTitle>

<DeploymentTopMenu Current="mirrors" />

@if (_mirrorServer is null)
{
    <div class="text-center text-secondary py-5">
        <i class="ti ti-server-off fs-1"></i>
        <p class="mt-2">Ce serveur miroir est introuvable.</p>
    </div>
}
else
{
    <div class="glpi-fiche-block">
        <div class="row">
            <div class="col-md-6">
                <div class="glpi-fiche-field">
                    <label>Nom</label>
                    <input class="form-control" @bind="_mirrorServer.Name" @bind:event="oninput" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="glpi-fiche-field">
                    <label>URL</label>
                    <input type="url" class="form-control" @bind="_mirrorServer.Url" @bind:event="oninput" />
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="glpi-fiche-field">
                    <label>Commentaires</label>
                    <textarea class="form-control" rows="2" @bind="_mirrorServer.Comment"></textarea>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-check form-switch mt-4">
                    <input class="form-check-input" type="checkbox" role="switch" id="mirrorServerActive" @bind="_mirrorServer.IsActive" />
                    <label class="form-check-label" for="mirrorServerActive">Actif</label>
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-end gap-2 mt-3">
            <button type="button" class="btn btn-outline-danger" @onclick="DeleteAsync">
                <i class="ti ti-trash me-1"></i>Supprimer définitivement
            </button>
            <button type="button" class="btn btn-primary" disabled="@_isSaving" @onclick="SaveAsync">
                <i class="ti ti-device-floppy me-1"></i>@(_isSaving ? "Enregistrement…" : "Sauvegarder")
            </button>
        </div>
    </div>
}
