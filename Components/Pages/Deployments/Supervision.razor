@page "/tools/deployments/supervision"
@using GlpiNg.Modules.Deployment.Models
@rendermode InteractiveServer

<PageTitle>@T("Déploiements — GlpiNg")</PageTitle>

<DeploymentTopMenu Current="supervision" />

<div class="glping-list-page">
<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between glping-list-toolbar">
        <span class="text-secondary">@T("{0} exécution(s) de tâche de déploiement", _jobs.Count)</span>
        <button type="button" class="btn btn-icon" @onclick="LoadAsync" title="@(T("Rafraîchir"))">
            <i class="ti ti-refresh"></i>
        </button>
    </div>

    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th>@T("ID")</th>
                    <th>@T("Paquet")</th>
                    <th>@T("Agent")</th>
                    <th>@T("Statut")</th>
                    <th>@T("Créé le")</th>
                    <th>@T("Démarré le")</th>
                    <th>@T("Terminé le")</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_jobs.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center text-secondary py-4">@T("Aucune exécution de tâche de déploiement.")</td>
                    </tr>
                }
                else
                {
                    @foreach (DeploymentJob job in _jobs)
                    {
                        <tr>
                            <td>@job.Id</td>
                            <td>
                                @if (job.Package is not null)
                                {
                                    <a href="@($"/tools/deployments/package/{job.Package.Id}")">@job.Package.Name</a>
                                }
                                else
                                {
                                    <span class="text-secondary">—</span>
                                }
                            </td>
                            <td>@(job.Agent?.AgentName ?? job.Agent?.DeviceId ?? job.Agent?.Hostname ?? "—")</td>
                            <td><span class="badge @StatusBadgeClass(job.Status)">@StatusLabel(job.Status)</span></td>
                            <td>@Display.DateTime(job.CreatedAt)</td>
                            <td>@(job.StartedAt is { } started ? Display.DateTime(started) : "—")</td>
                            <td>@(job.CompletedAt is { } completed ? Display.DateTime(completed) : "—")</td>
                            <td class="text-end">
                                @if (!string.IsNullOrWhiteSpace(job.Log))
                                {
                                    <button type="button" class="btn btn-sm" @onclick="() => ToggleLog(job.Id)">
                                        <i class="ti ti-file-text me-1"></i>@T("Journal")
                                    </button>
                                }
                            </td>
                        </tr>
                        @if (_expandedJobId == job.Id && !string.IsNullOrWhiteSpace(job.Log))
                        {
                            <tr>
                                <td colspan="8">
                                    <pre class="mb-0 p-2 bg-body-secondary rounded">@job.Log</pre>
                                </td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>
</div>
</div>
