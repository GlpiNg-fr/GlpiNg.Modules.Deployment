@page "/tools/deployments/interaction-templates/{TemplateId:int}"
@using GlpiNg.Modules.Deployment.Models
@rendermode InteractiveServer

<PageTitle>GlpiNg — @(_template?.Name ?? "Gabarit d'interaction")</PageTitle>

<DeploymentTopMenu Current="interactiontemplates" />

@if (_template is null)
{
    <div class="text-center text-secondary py-5">
        <i class="ti ti-message-off fs-1"></i>
        <p class="mt-2">Ce gabarit d'interaction est introuvable.</p>
    </div>
}
else
{
    <div class="glpi-fiche-block">
        <div class="row">
            <div class="col-md-6">
                <div class="glpi-fiche-field">
                    <label>Nom</label>
                    <input class="form-control" @bind="_template.Name" @bind:event="oninput" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="glpi-fiche-field">
                    <label>Type</label>
                    <select class="form-select" @bind="_template.Type">
                        @foreach (DeploymentUserInteractionType type in Enum.GetValues<DeploymentUserInteractionType>())
                        {
                            <option value="@type">@InteractionTypeLabel(type)</option>
                        }
                    </select>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="glpi-fiche-field">
                    <label>Texte affiché à l'utilisateur</label>
                    <textarea class="form-control" rows="3" @bind="_template.Text"></textarea>
                </div>
            </div>
            <div class="col-md-6">
                <div class="glpi-fiche-field">
                    <label>Commentaires</label>
                    <textarea class="form-control" rows="2" @bind="_template.Comment"></textarea>
                </div>
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox" role="switch" id="templateAllowSkip" @bind="_template.AllowSkip" />
                    <label class="form-check-label" for="templateAllowSkip">Ignorable</label>
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-end gap-2 mt-3">
            <button type="button" class="btn btn-outline-danger" @onclick="DeleteAsync">
                <i class="ti ti-trash me-1"></i>Supprimer définitivement
            </button>
            <button type="button" class="btn btn-primary" disabled="@_isSaving" @onclick="SaveAsync">
                <i class="ti ti-device-floppy me-1"></i>@(_isSaving ? "Enregistrement…" : "Sauvegarder")
            </button>
        </div>
    </div>
}
