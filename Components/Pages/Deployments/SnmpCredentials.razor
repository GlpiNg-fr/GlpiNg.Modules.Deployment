@page "/tools/deployments/snmpcredentials"
@using GlpiNg.Modules.Deployment.Models
@rendermode InteractiveServer

<PageTitle>GlpiNg — Déploiements</PageTitle>

<DeploymentTopMenu Current="snmpcredentials" />

<div class="glpi-list-page">
<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between glpi-list-toolbar">
        <label class="form-check m-0 px-2" title="Tout sélectionner">
            <input class="form-check-input m-0" type="checkbox" checked="@AllSelected"
                   @onchange="@((ChangeEventArgs e) => ToggleSelectAll((bool)(e.Value ?? false)))" />
        </label>

        <div class="btn-list align-items-center">
            <div class="dropdown">
                <button type="button" class="btn btn-icon text-danger" data-bs-toggle="dropdown" aria-expanded="false"
                        disabled="@(_selectedIds.Count == 0)" title="Supprimer la sélection">
                    <i class="ti ti-trash"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-end p-3" style="min-width: 260px;">
                    <p class="mb-2">Supprimer @_selectedIds.Count identifiant(s) sélectionné(s) ?</p>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-sm">Annuler</button>
                        <button type="button" class="btn btn-sm btn-danger" @onclick="DeleteSelectedAsync">Supprimer</button>
                    </div>
                </div>
            </div>

            <button type="button" class="btn btn-icon" @onclick="LoadAsync" title="Rafraîchir">
                <i class="ti ti-refresh"></i>
            </button>

            <button type="button" class="btn btn-primary" @onclick="OpenCreateModalAsync">
                <i class="ti ti-plus me-1"></i>Nouvel identifiant SNMP
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th style="width: 2.5rem;">
                        @* Ne coche que les lignes affichées — la page courante là où le tableau est
                           paginé : cocher ici ne doit jamais engager plus que ce qu'on voit. *@
                        <input class="form-check-input m-0" type="checkbox" title="Sélectionner les éléments visibles"
                               checked="@AllSelected"
                               @onchange="@((ChangeEventArgs e) => ToggleSelectAll((bool)(e.Value ?? false)))" />
                    </th>
                    <th>Nom</th>
                    <th>Version SNMP</th>
                    <th>Détail</th>
                </tr>
            </thead>
            <tbody>
                @if (_credentials.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="text-center text-secondary py-4">Aucun identifiant SNMP.</td>
                    </tr>
                }
                else
                {
                    @foreach (SnmpCredential credential in _credentials)
                    {
                        <tr>
                            <td>
                                <input class="form-check-input m-0" type="checkbox" checked="@_selectedIds.Contains(credential.Id)"
                                       @onchange="@((ChangeEventArgs e) => ToggleSelect(credential.Id, (bool)(e.Value ?? false)))" />
                            </td>
                            <td>
                                <a href="#" @onclick="@(() => OpenEditModalAsync(credential))" @onclick:preventDefault class="text-reset fw-semibold">
                                    <i class="ti ti-key me-1 text-secondary"></i>@credential.Name
                                </a>
                            </td>
                            <td>@VersionLabel(credential.Version)</td>
                            <td>
                                @if (credential.Version == SnmpVersion.V3)
                                {
                                    @($"{credential.Username} · {credential.AuthProtocol}/{credential.PrivProtocol}")
                                }
                                else
                                {
                                    @credential.Community
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
</div>

<div class="modal fade" id="snmpCredentialModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="ti ti-key me-2"></i>@(_editingId is null ? "Nouvel élément" : "Modifier") - Identifiant SNMP</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                <div class="glpi-fiche-field">
                    <label>Nom</label>
                    <input class="form-control" @bind="_editForm.Name" @bind:event="oninput" />
                </div>
                <div class="glpi-fiche-field">
                    <label>Version SNMP</label>
                    <select class="form-select" value="@_editForm.Version" @onchange="@((ChangeEventArgs e) => _editForm.Version = Enum.Parse<SnmpVersion>((string)e.Value!))">
                        <option value="@SnmpVersion.V1">1</option>
                        <option value="@SnmpVersion.V2c">2c</option>
                        <option value="@SnmpVersion.V3">3</option>
                    </select>
                </div>

                @if (_editForm.Version is SnmpVersion.V1 or SnmpVersion.V2c)
                {
                    <div class="glpi-fiche-field">
                        <label>Communauté</label>
                        <input class="form-control" @bind="_editForm.Community" @bind:event="oninput" />
                    </div>
                }
                else
                {
                    <div class="glpi-fiche-field">
                        <label>Utilisateur</label>
                        <input class="form-control" @bind="_editForm.Username" @bind:event="oninput" />
                    </div>
                    <div class="glpi-fiche-field">
                        <label>Authentification</label>
                        <select class="form-select" value="@_editForm.AuthProtocol" @onchange="@((ChangeEventArgs e) => _editForm.AuthProtocol = Enum.Parse<SnmpAuthProtocol>((string)e.Value!))">
                            @foreach (SnmpAuthProtocol protocol in Enum.GetValues<SnmpAuthProtocol>())
                            {
                                <option value="@protocol">@protocol</option>
                            }
                        </select>
                    </div>
                    <div class="glpi-fiche-field">
                        <label>Phrase secrète d'authentification</label>
                        <input type="password" class="form-control" @bind="_editForm.AuthPassphrase" @bind:event="oninput" />
                    </div>
                    <div class="glpi-fiche-field">
                        <label>Chiffrement</label>
                        <select class="form-select" value="@_editForm.PrivProtocol" @onchange="@((ChangeEventArgs e) => _editForm.PrivProtocol = Enum.Parse<SnmpPrivProtocol>((string)e.Value!))">
                            @foreach (SnmpPrivProtocol protocol in Enum.GetValues<SnmpPrivProtocol>())
                            {
                                <option value="@protocol">@protocol</option>
                            }
                        </select>
                    </div>
                    <div class="glpi-fiche-field">
                        <label>Phrase secrète de chiffrement</label>
                        <input type="password" class="form-control" @bind="_editForm.PrivPassphrase" @bind:event="oninput" />
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning" disabled="@string.IsNullOrWhiteSpace(_editForm.Name)" @onclick="SaveAsync">
                    <i class="ti ti-check me-1"></i>@(_editingId is null ? "Ajouter" : "Enregistrer")
                </button>
            </div>
        </div>
    </div>
</div>
