@page "/tools/deployments/timeslots/{TimeSlotId:int}"
@using GlpiNg.Modules.Deployment.Models
@rendermode InteractiveServer

<PageTitle>@(_timeSlot?.Name ?? T("Créneau horaire")) — GlpiNg</PageTitle>

<DeploymentTopMenu Current="timeslots" />

@if (_timeSlot is null)
{
    <div class="text-center text-secondary py-5">
        <i class="ti ti-calendar-off fs-1"></i>
        <p class="mt-2">@T("Ce créneau horaire est introuvable.")</p>
    </div>
}
else
{
    <div class="glping-fiche-block">
        <div class="row">
            <div class="col-md-6">
                <div class="glping-fiche-field">
                    <label>@T("Nom")</label>
                    <input class="form-control" @bind="_timeSlot.Name" @bind:event="oninput" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="glping-fiche-field">
                    <label>@T("Commentaires")</label>
                    <textarea class="form-control" rows="2" @bind="_timeSlot.Comment"></textarea>
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-end gap-2 mt-3">
            <button type="button" class="btn btn-outline-danger" @onclick="DeleteAsync">
                <i class="ti ti-trash me-1"></i>@T("Supprimer définitivement")
            </button>
            <button type="button" class="btn btn-primary" disabled="@_isSaving" @onclick="SaveAsync">
                <i class="ti ti-device-floppy me-1"></i>@(_isSaving ? T("Enregistrement…") : T("Sauvegarder"))
            </button>
        </div>
    </div>

    <div class="glping-fiche-block">
        <div class="glping-fiche-block-title"><i class="ti ti-clock"></i>@T("Entrées ({0})", _timeSlot.Entries.Count)</div>

        @if (_timeSlot.Entries.Count > 0)
        {
            <div class="table-responsive mb-3">
                <table class="table table-vcenter card-table mb-0">
                    <thead>
                        <tr>
                            <th>@T("Jour")</th>
                            <th>@T("Début")</th>
                            <th>@T("Fin")</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (TimeSlotEntry entry in _timeSlot.Entries.OrderBy(e => (int)e.DayOfWeek == 0 ? 7 : (int)e.DayOfWeek).ThenBy(e => e.StartTime))
                        {
                            <tr>
                                <td>@DayLabel(entry.DayOfWeek)</td>
                                <td>@entry.StartTime.ToString("HH:mm")</td>
                                <td>@entry.EndTime.ToString("HH:mm")</td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-icon text-danger" @onclick="() => RemoveEntryAsync(entry)">
                                        <i class="ti ti-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">@T("Jour")</label>
                <select class="form-select" @bind="_newDay">
                    <option value="@DayOfWeek.Monday">@T("Lundi")</option>
                    <option value="@DayOfWeek.Tuesday">@T("Mardi")</option>
                    <option value="@DayOfWeek.Wednesday">@T("Mercredi")</option>
                    <option value="@DayOfWeek.Thursday">@T("Jeudi")</option>
                    <option value="@DayOfWeek.Friday">@T("Vendredi")</option>
                    <option value="@DayOfWeek.Saturday">@T("Samedi")</option>
                    <option value="@DayOfWeek.Sunday">@T("Dimanche")</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">@T("Heure de début")</label>
                <input type="time" class="form-control" @bind="_newStart" />
            </div>
            <div class="col-md-3">
                <label class="form-label">@T("Heure de fin")</label>
                <input type="time" class="form-control" @bind="_newEnd" />
            </div>
            <div class="col-md-3">
                <button type="button" class="btn btn-primary w-100" @onclick="AddEntryAsync">
                    <i class="ti ti-plus me-1"></i>@T("Ajouter")
                </button>
            </div>
        </div>
    </div>
}
