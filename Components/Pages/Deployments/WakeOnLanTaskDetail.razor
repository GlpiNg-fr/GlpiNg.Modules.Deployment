@page "/tools/deployments/wakeonlan/{TaskId:int}"
@using GlpiNg.Modules.Inventory.Models
@using GlpiNg.Modules.Deployment.Models
@rendermode InteractiveServer

<PageTitle>@(_task?.Name ?? T("Tâche de réveil réseau")) — GlpiNg</PageTitle>

<DeploymentTopMenu Current="wakeonlantasks" />

@if (_task is null)
{
    <div class="text-center text-secondary py-5">
        <i class="ti ti-plug-connected fs-1"></i>
        <p class="mt-2">@T("Cette tâche de réveil réseau est introuvable.")</p>
    </div>
}
else
{
    <div class="glping-fiche-topbar">
        <a class="glping-fiche-pager-btn" href="/tools/deployments/wakeonlan" title="@(T("Retour à la liste"))">
            <i class="ti ti-list"></i>
        </a>
        <div class="glping-fiche-crumb">
            <i class="ti ti-plug-connected"></i>
            <span>@T("Tâche de réveil réseau - {0} - ID {1}", _task.Name, _task.Id)</span>
        </div>
        <div class="glping-fiche-toolbar">
            <span class="text-secondary me-2">
                <i class="ti ti-history me-1"></i>@T("Dernière exécution : {0}", _task.LastLaunchedAt is { } last ? Display.DateTime(last) : "jamais")
            </span>
            <button type="button" class="btn btn-primary" disabled="@(LaunchDisabledReason(_task) is not null || _isLaunching)"
                    title="@(LaunchDisabledReason(_task) ?? T("Lancer maintenant"))" @onclick="LaunchAsync">
                @if (_isLaunching)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                else
                {
                    <i class="ti ti-player-play me-1"></i>
                }
                @T("Lancer maintenant")
            </button>
        </div>
    </div>

    @if (_launchMessage is not null)
    {
        <div class="alert @(_launchMessageIsError ? "alert-danger" : "alert-success") alert-dismissible">
            <i class="ti @(_launchMessageIsError ? "ti-alert-triangle" : "ti-circle-check") me-1"></i>@_launchMessage
            <a class="btn-close" @onclick="@(() => _launchMessage = null)"></a>
        </div>
    }

    <div class="glping-fiche-layout">
        <aside class="glping-fiche-sidebar">
            <button type="button" class="glping-fiche-tab-item @(_activeTabKey == "main" ? "active" : "")" @onclick='() => SetTab("main")'>
                <i class="ti ti-settings"></i>
                <span>@T("Principal")</span>
            </button>
            <button type="button" class="glping-fiche-tab-item @(_activeTabKey == "targets" ? "active" : "")" @onclick='() => SetTab("targets")'>
                <i class="ti ti-target-arrow"></i>
                <span>@T("Cibles")</span>
                <span class="glping-fiche-tab-count">@_task.Targets.Count</span>
            </button>
            <button type="button" class="glping-fiche-tab-item @(_activeTabKey == "actors" ? "active" : "")" @onclick='() => SetTab("actors")'>
                <i class="ti ti-router"></i>
                <span>@T("Agents relais")</span>
                <span class="glping-fiche-tab-count">@_task.RelayAgents.Count</span>
            </button>
            <button type="button" class="glping-fiche-tab-item @(_activeTabKey == "history" ? "active" : "")" @onclick='() => SetTab("history")'>
                <i class="ti ti-history"></i>
                <span>@T("Exécutions des jobs")</span>
                <span class="glping-fiche-tab-count">@_task.Jobs.Count</span>
            </button>
        </aside>

        <div class="glping-fiche-panel">
            @switch (_activeTabKey)
            {
                case "main":
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="glping-fiche-field">
                                <label>@T("Nom")</label>
                                <input class="form-control" @bind="_task.Name" @bind:event="oninput" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="glping-fiche-field">
                                <label>@T("Commentaires")</label>
                                <textarea class="form-control" rows="3" @bind="_task.Comment"></textarea>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-check mt-4">
                                <input class="form-check-input" type="checkbox" id="wakeOnLanTaskActive" @bind="_task.IsActive" />
                                <label class="form-check-label" for="wakeOnLanTaskActive">@T("Activé")</label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="glping-fiche-field">
                                <label>@T("Heure de démarrage planifiée")</label>
                                <div class="input-group">
                                    <input type="datetime-local" class="form-control" @bind="_task.ScheduledStartTime" />
                                    <button type="button" class="btn btn-icon" @onclick="() => _task.ScheduledStartTime = null" title="@(T("Effacer"))">
                                        <i class="ti ti-x"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="glping-fiche-field">
                                <label>@T("Heure de fin planifiée")</label>
                                <div class="input-group">
                                    <input type="datetime-local" class="form-control" @bind="_task.ScheduledEndTime" />
                                    <button type="button" class="btn btn-icon" @onclick="() => _task.ScheduledEndTime = null" title="@(T("Effacer"))">
                                        <i class="ti ti-x"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="glping-fiche-field">
                                <label>@T("Créneau horaire d'exécution")</label>
                                <div class="input-group">
                                    <select class="form-select" @bind="_task.ExecutionTimeSlotId">
                                        <option value="">-----</option>
                                        @foreach (TimeSlot slot in _availableTimeSlots)
                                        {
                                            <option value="@slot.Id">@slot.Name</option>
                                        }
                                    </select>
                                    <button type="button" class="btn btn-icon" title="@(T("{0}", TimeSlotTooltip(_task.ExecutionTimeSlotId)))">
                                        <i class="ti ti-info-circle"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <small class="text-secondary">
                                @T("Créneaux gérés depuis") <a href="/tools/deployments/timeslots">@T("Créneau horaire")</a>@T(". Appliqué automatiquement par le module Scheduler (lancement automatique dès que la fenêtre s'ouvre), même mécanique que pour les tâches de déploiement de paquets et les tâches réseau.")
                            </small>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button type="button" class="btn btn-outline-danger" @onclick="DeleteAsync">
                            <i class="ti ti-trash me-1"></i>@T("Supprimer définitivement")
                        </button>
                        <button type="button" class="btn btn-primary" disabled="@_isSaving" @onclick="SaveAsync">
                            <i class="ti ti-device-floppy me-1"></i>@(_isSaving ? T("Enregistrement…") : T("Sauvegarder"))
                        </button>
                    </div>
                    break;

                case "targets":
                    <div class="glping-fiche-block">
                        <div class="glping-fiche-block-title"><i class="ti ti-target-arrow"></i>@T("Cibles ({0})", _task.Targets.Count)</div>
                        <p class="text-secondary">
                            @T("Groupes d'ordinateurs (statiques ou dynamiques) et/ou ordinateurs individuels à réveiller. L'adresse MAC de chaque ordinateur est résolue au lancement à partir de son inventaire réseau.")
                        </p>

                        @if (_task.Targets.Count > 0)
                        {
                            <div class="table-responsive mb-3">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>@T("Type")</th>
                                            <th>@T("Nom")</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (WakeOnLanTaskTarget target in _task.Targets)
                                        {
                                            <tr>
                                                <td>@TargetTypeLabel(target.Type)</td>
                                                <td>
                                                    @if (target.Type == WakeOnLanTaskTargetType.Computer && target.Computer is not null)
                                                    {
                                                        <a href="@($"/parc/computer/{target.Computer.Id}")">@target.Computer.Name</a>
                                                    }
                                                    else if (target.Type == WakeOnLanTaskTargetType.Group && target.Group is not null)
                                                    {
                                                        <a href="@($"/tools/deployments/computer-groups/{target.Group.Id}")">@target.Group.Name</a>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-secondary">—</span>
                                                    }
                                                </td>
                                                <td class="text-end">
                                                    <button type="button" class="btn btn-sm btn-icon text-danger" @onclick="() => RemoveTargetAsync(target)">
                                                        <i class="ti ti-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <small class="text-secondary d-block mb-3">@T("Sans cible, cette tâche ne peut pas être lancée.")</small>
                        }

                        <div class="row g-2 align-items-end">
                            <div class="col-md-3">
                                <label class="form-label">@T("Type")</label>
                                <select class="form-select" @bind="_targetTypeToAdd">
                                    <option value="@WakeOnLanTaskTargetType.Group">@T("Groupe d'ordinateurs")</option>
                                    <option value="@WakeOnLanTaskTargetType.Computer">@T("Ordinateur")</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                @if (_targetTypeToAdd == WakeOnLanTaskTargetType.Group)
                                {
                                    <label class="form-label">@T("Groupe")</label>
                                    <select class="form-select" @bind="_groupIdToAdd">
                                        <option value="0">@T("-- Choisir un groupe --")</option>
                                        @foreach (DeployComputerGroup group in GroupsToAdd)
                                        {
                                            <option value="@group.Id">@group.Name (@(group.Type == DeployComputerGroupType.Dynamic ? "dynamique" : "statique"))</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <label class="form-label">@T("Ordinateur")</label>
                                    <select class="form-select" @bind="_computerIdToAdd">
                                        <option value="0">@T("-- Choisir un ordinateur --")</option>
                                        @foreach (Computer computer in ComputersToAdd)
                                        {
                                            <option value="@computer.Id">@computer.Name</option>
                                        }
                                    </select>
                                }
                            </div>
                            <div class="col-md-3">
                                <button type="button" class="btn btn-primary w-100"
                                        disabled="@(_targetTypeToAdd == WakeOnLanTaskTargetType.Group ? _groupIdToAdd == 0 : _computerIdToAdd == 0)"
                                        @onclick="AddTargetAsync">
                                    <i class="ti ti-plus me-1"></i>@T("Ajouter")
                                </button>
                            </div>
                        </div>
                    </div>
                    break;

                case "actors":
                    <div class="glping-fiche-block">
                        <div class="glping-fiche-block-title"><i class="ti ti-router"></i>@T("Agents relais ({0})", _task.RelayAgents.Count)</div>
                        <p class="text-secondary">
                            @T("Agents GLPI-Agent chargés d'émettre le magic packet — doivent être sur le même sous-réseau que les cibles pour que le broadcast les atteigne.")
                        </p>

                        @if (_task.RelayAgents.Count > 0)
                        {
                            <div class="table-responsive mb-3">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>@T("Agent")</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (WakeOnLanTaskActor actor in _task.RelayAgents)
                                        {
                                            <tr>
                                                <td>@(actor.Agent?.AgentName ?? actor.Agent?.DeviceId ?? actor.Agent?.Hostname ?? "—")</td>
                                                <td class="text-end">
                                                    <button type="button" class="btn btn-sm btn-icon text-danger" @onclick="() => RemoveActorAsync(actor)">
                                                        <i class="ti ti-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <small class="text-secondary d-block mb-3">@T("Sans agent relais, cette tâche ne peut pas être lancée.")</small>
                        }

                        <div class="d-flex gap-2">
                            <select class="form-select" style="max-width: 320px;" @bind="_agentIdToAdd">
                                <option value="0">@T("-- Choisir un agent --")</option>
                                @foreach (GlpiAgent agent in AgentsToAdd)
                                {
                                    <option value="@agent.Id">@(agent.AgentName ?? agent.DeviceId ?? agent.Hostname)</option>
                                }
                            </select>
                            <button type="button" class="btn btn-primary" disabled="@(_agentIdToAdd == 0)" @onclick="AddActorAsync">
                                <i class="ti ti-plus me-1"></i>@T("Ajouter")
                            </button>
                        </div>
                    </div>
                    break;

                case "history":
                    <div class="glping-fiche-block">
                        <div class="glping-fiche-block-title"><i class="ti ti-history"></i>@T("Exécutions ({0})", _task.Jobs.Count)</div>

                        @if (_task.Jobs.Count == 0)
                        {
                            <div class="glping-config-placeholder">
                                <i class="ti ti-history-toggle"></i>
                                <p class="mb-0">@T("Cette tâche n'a jamais été lancée.")</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>@T("Agent relais")</th>
                                            <th>@T("Cibles")</th>
                                            <th>@T("Statut")</th>
                                            <th>@T("Créé le")</th>
                                            <th>@T("Démarré le")</th>
                                            <th>@T("Terminé le")</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (WakeOnLanTaskJob job in _task.Jobs.OrderByDescending(j => j.CreatedAt))
                                        {
                                            <tr>
                                                <td>@(job.Agent?.AgentName ?? job.Agent?.DeviceId ?? job.Agent?.Hostname ?? "—")</td>
                                                <td>@TargetCount(job)</td>
                                                <td><span class="badge @StatusBadgeClass(job.Status)">@StatusLabel(job.Status)</span></td>
                                                <td>@Display.DateTime(job.CreatedAt)</td>
                                                <td>@(job.StartedAt is { } started ? Display.DateTime(started) : "—")</td>
                                                <td>@(job.CompletedAt is { } completed ? Display.DateTime(completed) : "—")</td>
                                                <td class="text-end">
                                                    @if (!string.IsNullOrWhiteSpace(job.Log))
                                                    {
                                                        <button type="button" class="btn btn-sm" @onclick="() => ToggleLog(job.Id)">
                                                            <i class="ti ti-file-text me-1"></i>@T("Journal")
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                            @if (_expandedJobId == job.Id && !string.IsNullOrWhiteSpace(job.Log))
                                            {
                                                <tr>
                                                    <td colspan="7">
                                                        <div class="glping-job-log">@RenderLog(job.Log)</div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                    break;
            }
        </div>
    </div>
}
