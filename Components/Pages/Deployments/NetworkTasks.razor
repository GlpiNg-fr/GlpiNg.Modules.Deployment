@page "/tools/deployments/networktasks"
@using GlpiNg.Modules.Deployment.Models
@rendermode InteractiveServer

<PageTitle>@T("Déploiements — GlpiNg")</PageTitle>

<DeploymentTopMenu Current="networktasks" />

<div class="glping-list-page">

@if (_launchMessage is not null)
{
    <div class="alert @(_launchMessageIsError ? "alert-danger" : "alert-success") alert-dismissible">
        <i class="ti @(_launchMessageIsError ? "ti-alert-triangle" : "ti-circle-check") me-1"></i>@_launchMessage
        <a class="btn-close" @onclick="@(() => _launchMessage = null)"></a>
    </div>
}

<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between glping-list-toolbar">
        <label class="form-check m-0 px-2" title="@(T("Tout sélectionner"))">
            <input class="form-check-input m-0" type="checkbox" checked="@AllSelected"
                   @onchange="@((ChangeEventArgs e) => ToggleSelectAll((bool)(e.Value ?? false)))" />
        </label>

        <div class="btn-list align-items-center">
            <div class="dropdown">
                <button type="button" class="btn btn-icon text-danger" data-bs-toggle="dropdown" aria-expanded="false"
                        disabled="@(_selectedIds.Count == 0)" title="@(T("Supprimer la sélection"))">
                    <i class="ti ti-trash"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-end p-3" style="min-width: 260px;">
                    <p class="mb-2">@T("Supprimer {0} tâche(s) sélectionnée(s) ? Cette action est définitive.", _selectedIds.Count)</p>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-sm">@T("Annuler")</button>
                        <button type="button" class="btn btn-sm btn-danger" @onclick="DeleteSelectedAsync">@T("Supprimer")</button>
                    </div>
                </div>
            </div>

            <button type="button" class="btn btn-icon" @onclick="LoadAsync" title="@(T("Rafraîchir"))">
                <i class="ti ti-refresh"></i>
            </button>

            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newNetworkTaskModal">
                <i class="ti ti-plus me-1"></i>@T("Nouvelle tâche réseau")
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th style="width: 2.5rem;">
                        @* Ne coche que les lignes affichées — la page courante là où le tableau est
                           paginé : cocher ici ne doit jamais engager plus que ce qu'on voit. *@
                        <input class="form-check-input m-0" type="checkbox" title="@(T("Sélectionner les éléments visibles"))"
                               checked="@AllSelected"
                               @onchange="@((ChangeEventArgs e) => ToggleSelectAll((bool)(e.Value ?? false)))" />
                    </th>
                    <th>@T("Nom")</th>
                    <th>@T("Méthode")</th>
                    <th>@T("Plages IP")</th>
                    <th>@T("Identifiants SNMP")</th>
                    <th>@T("Acteurs")</th>
                    <th>@T("Activé")</th>
                    <th>@T("Dernière exécution")</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_tasks.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="text-center text-secondary py-4">@T("Aucune tâche réseau trouvée.")</td>
                    </tr>
                }
                else
                {
                    @foreach (NetworkTask task in _tasks)
                    {
                        (int pending, int running, int success, int error) = JobStats(task);
                        <tr>
                            <td>
                                <input class="form-check-input m-0" type="checkbox" checked="@_selectedIds.Contains(task.Id)"
                                       @onchange="@((ChangeEventArgs e) => ToggleSelect(task.Id, (bool)(e.Value ?? false)))" />
                            </td>
                            <td>
                                <a href="@($"/tools/deployments/networktasks/{task.Id}")" class="text-reset fw-semibold">
                                    <i class="ti ti-radar-2 me-1 text-secondary"></i>@task.Name
                                </a>
                            </td>
                            <td>
                                @if (task.Method == NetworkTaskMethod.NetworkDiscovery)
                                {
                                    <span class="badge bg-azure-lt"><i class="ti ti-radar-2 me-1"></i>@T("Découverte réseau")</span>
                                }
                                else
                                {
                                    <span class="badge bg-purple-lt"><i class="ti ti-server-2 me-1"></i>@T("Inventaire réseau (SNMP)")</span>
                                }
                            </td>
                            <td>
                                @if (task.IpRanges.Count == 0)
                                {
                                    <span class="text-secondary">@T("Aucune plage")</span>
                                }
                                else
                                {
                                    <span class="badge bg-blue-lt">@T("{0} plage(s)", task.IpRanges.Count)</span>
                                }
                            </td>
                            <td>
                                @if (task.Method == NetworkTaskMethod.NetworkDiscovery)
                                {
                                    <span class="text-secondary">—</span>
                                }
                                else if (task.Credentials.Count == 0)
                                {
                                    <span class="text-secondary">@T("Aucun identifiant")</span>
                                }
                                else
                                {
                                    <span class="badge bg-blue-lt">@T("{0} identifiant(s)", task.Credentials.Count)</span>
                                }
                            </td>
                            <td>
                                @if (task.Actors.Count == 0)
                                {
                                    <span class="text-secondary">@T("Aucun acteur")</span>
                                }
                                else
                                {
                                    <span class="badge bg-azure-lt">@T("{0} acteur(s)", task.Actors.Count)</span>
                                }
                            </td>
                            <td>
                                @if (task.IsActive)
                                {
                                    <span class="badge bg-success-lt">@T("Oui")</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-lt">@T("Non")</span>
                                }
                            </td>
                            <td>
                                @if (task.LastLaunchedAt is { } lastLaunched)
                                {
                                    <div>@Display.DateTime(lastLaunched)</div>
                                    <div class="d-flex gap-1">
                                        @if (pending > 0)
                                        {
                                            <span class="badge bg-secondary-lt" title="@(T("En attente"))">@pending</span>
                                        }
                                        @if (running > 0)
                                        {
                                            <span class="badge bg-azure-lt" title="@(T("En cours"))">@running</span>
                                        }
                                        @if (success > 0)
                                        {
                                            <span class="badge bg-success-lt" title="@(T("Réussi"))">@success</span>
                                        }
                                        @if (error > 0)
                                        {
                                            <span class="badge bg-danger-lt" title="@(T("En erreur"))">@error</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-secondary">@T("Jamais lancée")</span>
                                }
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm" disabled="@(LaunchDisabledReason(task) is not null || _launchingTaskId is not null)"
                                        @onclick="() => LaunchAsync(task.Id)" title="@(LaunchDisabledReason(task) ?? T("Lancer maintenant"))">
                                    @if (_launchingTaskId == task.Id)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                    }
                                    else
                                    {
                                        <i class="ti ti-player-play me-1"></i>
                                    }
                                    @T("Lancer")
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
</div>

<div class="modal fade" id="newNetworkTaskModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="ti ti-radar-2 me-2"></i>@T("Nouvel élément - Tâche réseau")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@(T("Fermer"))"></button>
            </div>
            <div class="modal-body">
                <div class="glping-fiche-field">
                    <label>@T("Nom")</label>
                    <input class="form-control" @bind="_newTask.Name" @bind:event="oninput" />
                </div>
                <div class="glping-fiche-field">
                    <label>@T("Méthode du module")</label>
                    <select class="form-select" value="@_newTask.Method" @onchange="@((ChangeEventArgs e) => _newTask.Method = Enum.Parse<NetworkTaskMethod>((string)e.Value!))">
                        <option value="@NetworkTaskMethod.NetworkDiscovery">@T("Découverte réseau")</option>
                        <option value="@NetworkTaskMethod.NetworkInventory">@T("Inventaire réseau (SNMP)")</option>
                    </select>
                </div>
                <div class="glping-fiche-field">
                    <label>@T("Commentaires")</label>
                    <textarea class="form-control" rows="3" @bind="_newTask.Comment"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning" disabled="@string.IsNullOrWhiteSpace(_newTask.Name)" @onclick="CreateTaskAsync">
                    <i class="ti ti-plus me-1"></i>@T("Ajouter")
                </button>
            </div>
        </div>
    </div>
</div>
